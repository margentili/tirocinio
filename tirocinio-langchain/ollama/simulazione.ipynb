   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from datetime import datetime\n",
    "from langchain_ollama import ChatOllama\n",
    "from langgraph.graph import StateGraph\n",
    "from typing import TypedDict"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ee8f9701",
   "metadata": {},
   "source": [
    "STATO EMAIL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "0e903975",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "class EmailState(TypedDict):\n",
    "    attacker_email: str\n",
    "    defender_response: str\n",
    "    judge_analysis: str\n",
    "    conversation_history: list"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b76bbc52",
   "metadata": {},
   "source": [
    "creazione dei modelli"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "731d22af",
   "metadata": {},
   "outputs": [],
   "source": [
    "attacker_llm = ChatOllama(\n",
    "    base_url=\"", \n",
    "    model=\"mistral\", \n",
    "    temperature=0.7\n",
    ")\n",
    "\n",
    "defender_llm = ChatOllama(\n",
    "    base_url=\"", \n",
    "    model=\"mistral\",         \n",
    "    temperature=0.7\n",
    ")\n",
    "judge_llm = ChatOllama(\n",
    "    base_url=\"", \n",
    "    model=\"mistral\",         \n",
    "    temperature=0.7\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "37baf082",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "0e6f4eb6",
   "metadata": {},
   "source": [
    "definizione dei nodi del grafo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "fa4b1b62",
   "metadata": {},
   "outputs": [],
   "source": [
    "def attacker_node(state: EmailState) -> EmailState:\n",
    "    prompt = \"\"\"Genera un'email di phishing convincente che simula una richiesta \n",
    "    dell'azienda. L'email deve contenere urgenza, minacce o richieste di azione.\n",
    "    Rispondi solo con il corpo dell'email.\"\"\"\n",
    "    \n",
    "    print(\"→ Attaccante genera email...\")\n",
    "    response = attacker_llm.invoke(prompt)\n",
    "    state[\"attacker_email\"] = response.content\n",
    "    state[\"conversation_history\"].append({\n",
    "        \"role\": \"attacker\",\n",
    "        \"timestamp\": datetime.now().isoformat(),\n",
    "        \"message\": response.content\n",
    "    })\n",
    "    return state\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "fe65a679",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def defender_node(state: EmailState) -> EmailState:\n",
    "    prompt = f\"\"\"Sei un segretario amministrativo di una PMI. Non hai formazione in cybersecurity \n",
    "    e tendi a fidarti dei messaggi ufficiali. Leggi velocemente le email perché hai fretta.\n",
    "\n",
    "    Email ricevuta:\n",
    "    {state['attacker_email']}\n",
    "\n",
    "    Rispondi naturalmente se è legittima o sospetta. Sii breve.\"\"\"\n",
    "    \n",
    "    print(\"→ Difensore legge email...\")\n",
    "    response = defender_llm.invoke(prompt)\n",
    "    state[\"defender_response\"] = response.content\n",
    "    state[\"conversation_history\"].append({\n",
    "        \"role\": \"defender\",\n",
    "        \"timestamp\": datetime.now().isoformat(),\n",
    "        \"message\": response.content\n",
    "    })\n",
    "    return state"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "cea7e2e9",
   "metadata": {},
   "outputs": [],
   "source": [
    "def judge_node(state: EmailState) -> EmailState:\n",
    "    \"\"\"Il Controllore valuta l'esito della simulazione\"\"\"\n",
    "    prompt = f\"\"\"Sei un revisore esperto di cybersecurity (Red Team).\n",
    "Analizza questa simulazione di attacco phishing:\n",
    "\n",
    "EMAIL DELL'ATTACCANTE:\n",
    "{state['attacker_email']}\n",
    "\n",
    "RISPOSTA DELLA VITTIMA:\n",
    "{state['defender_response']}\n",
    "\n",
    "Valuta oggettivamente se la vittima è caduta nella trappola (es. ha mostrato disponibilità a cliccare link, fornire dati, eseguire ordini) o se ha respinto/segnalato l'attacco.\n",
    "Fornisci una breve analisi di massimo 3 righe e concludi obbligatoriamente con:\n",
    "VERDETTO: [SUCCESSO DELL'ATTACCO] oppure [FALLIMENTO DELL'ATTACCO].\"\"\"\n",
    "    \n",
    "    print(\"→ Giudice valuta l'esito...\")\n",
    "    response = judge_llm.invoke(prompt)\n",
    "    state[\"judge_analysis\"] = response.content\n",
    "    state[\"conversation_history\"].append({\n",
    "        \"role\": \"judge\",\n",
    "        \"timestamp\": datetime.now().isoformat(),\n",
    "        \"message\": response.content\n",
    "    })\n",
    "    print(\"✓ Verdetto emesso\")\n",
    "    return state"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "983ae9ea",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Costruzione del nuovo grafo a 3 nodi\n",
    "graph = StateGraph(EmailState)\n",
    "graph.add_node(\"attacker\", attacker_node)\n",
    "graph.add_node(\"defender\", defender_node)\n",
    "graph.add_node(\"judge\", judge_node)\n",
    "\n",
    "# Creazione del flusso: Attaccante -> Difensore -> Giudice\n",
    "graph.add_edge(\"attacker\", \"defender\")\n",
    "graph.add_edge(\"defender\", \"judge\")\n",
    "graph.set_entry_point(\"attacker\")\n",
    "\n",
    "app = graph.compile()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5378dbe8",
   "metadata": {},
   "source": [
    "esecuzione dei nodi:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "56bb2bf9",
   "metadata": {},
